# ScrapeOps API密钥，用于访问Truth Social API
SCRAPE_PROXY_KEY=your_scrapeops_api_key_here

# Lark Webhook URL，用于发送通知
# 例如：https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LARK_WEBHOOK_URL=your_lark_webhook_url_here

# 健康检查通知URL，用于发送爬虫异常状态报告
# 当爬虫遇到问题或无法访问目标网站时，会发送通知到此URL
HEALTH_CHECK_URL=your_health_check_webhook_url_here 

# DeepSeek API密钥，用于分析文本
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 是否分析金融市场影响，默认开启
ANALYZE_MARKET=true